Options -Indexes
DirectoryIndex index.php
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
RewriteEngine On

# HTTPS + host canônico (www)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://www.dolarhoje.net.br%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} !^www\.dolarhoje\.net\.br$ [NC]
RewriteRule ^ https://www.dolarhoje.net.br%{REQUEST_URI} [L,R=301]

# .php antigo na RAIZ (libra.php, etc.) e qualquer rota inexistente vão para o index.php,
# que responde com 200, 301 ou 404 corretos. Scripts em subpastas (ex.: /apps/query.php) rodam normalmente.
RewriteRule ^index\.php$ - [L]
# query.php (script antigo de cotações) liberado: executa o arquivo físico normalmente
RewriteRule ^query\.php$ - [L]
# webhook de deploy do GitHub (arquivo físico, protegido por assinatura HMAC)
RewriteRule ^deploy-webhook\.php$ - [L]
# artigos do blog (posts/*.php) não são páginas: qualquer acesso direto cai no 404 do index.php
RewriteRule ^posts(/|$) index.php [L]
RewriteRule ^[^/]+\.php$ index.php [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
</IfModule>

# Segredos e arquivos internos
<FilesMatch "^(config\.php|deploy-secret\.php|\.git.*|\.cpanel\.yml|.*\.(md|log|sql|bak))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/json application/xml application/javascript
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
